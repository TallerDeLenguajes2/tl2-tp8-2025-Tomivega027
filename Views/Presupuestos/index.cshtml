@model List<miproyecto.models.Presupuestos>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Listado de Presupuestos</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Presupuesto</a>
    </div>

    <div class="card shadow-lg">
        <div class="card-body p-0">

            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Destinatario</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">
                                No hay presupuestos cargados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.idPresupuestos</td>
                                <td>@p.nombreDestinatario</td>
                                <td>@p.fechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>$ @p.MontoPresupuesto()</td>
                                <td class="text-center">

                                    <a asp-action="Detalles" asp-route-id="@p.idPresupuestos"
                                       class="btn btn-info btn-sm me-1">
                                        Ver
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@p.idPresupuestos"
                                       class="btn btn-warning btn-sm me-1">
                                        Editar
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@p.idPresupuestos"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>

                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>

        </div>
    </div>

</div>
