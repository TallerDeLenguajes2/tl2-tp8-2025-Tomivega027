@model List<miproyecto.models.Productos>

@{
    ViewData["Title"] = "Listado de Productos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">@ViewData["Title"]</h2>

        <a asp-action="Create" class="btn btn-success shadow-sm px-3">
            <i class="bi bi-plus-circle"></i> Crear Producto
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            <strong>No hay productos cargados aún.</strong>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 10%;">ID</th>
                            <th style="width: 50%;">Descripción</th>
                            <th style="width: 20%;">Precio</th>
                            <th style="width: 20%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td class="fw-bold">@producto.idProducto</td>
                                <td>@producto.descripcion</td>
                                <td>$@producto.precio</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@producto.idProducto" class="btn btn-warning btn-sm me-2">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@producto.idProducto" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
