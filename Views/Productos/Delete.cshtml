@model miproyecto.models.Productos

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary fw-bold">
        <i class="bi bi-plus-circle"></i> @ViewData["Title"]
    </h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descripción</label>
                    <input type="text" class="form-control" asp-for="descripcion" placeholder="Ingrese la descripción">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Precio</label>
                    <input class="form-control" asp-for="precio" placeholder="Ej: 1500">
                </div>

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check2-circle"></i> Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2 px-4">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>
